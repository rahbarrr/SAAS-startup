{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "development-android": {
      "extends": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "development-ios": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "development-ios-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  }
}

