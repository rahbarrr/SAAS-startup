{
  "name": "fieldtrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,mjs,ts,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,mjs,ts,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"**/database-rls.test.ts\" --exclude \"node_modules/**\"",
    "test:integration": "vitest run src/modules/tenancy/__tests__/database-rls.test.ts",
    "lint:migrations": "node scripts/migration-lint.mjs"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.65.0",
    "motion": "^14.9.0",
    "next": "^16.4.2",
    "nodemailer": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.21.0",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.187.0",
    "eslint": "^9.21.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^5.0.5"
  }
