# ============================================================================
# FieldTrack Environment Configuration Template
# Copy this file to `.env.local` for local development.
# NEVER commit `.env` or `.env.local` or real credentials to version control.
# ============================================================================

# [Public - Browser & Server]
# Base URL of the Supabase project used for authentication and RLS-protected queries.
NEXT_PUBLIC_SUPABASE_URL=

# [Public - Browser & Server]
# Trusted canonical app origin (e.g. https://app.example.com). Production uses it for
# authentication and invitation URLs. Preview auth callbacks use it when set, so the host
# must match the public host users open; Preview invitation links continue to use validated
# VERCEL_URL. Client-supplied origins are not trusted. Add exact callback URLs to Supabase.
NEXT_PUBLIC_APP_URL=

# [Vercel system value - Server Only]
# Automatically provided by Vercel for Preview deployments. The server validates
# this hostname before using it in invitation links; never derive links from Host headers.
VERCEL_ENV=
VERCEL_URL=

# [Public - Browser & Server]
# Supabase anonymous/public key. Safe for client bundles ONLY when Row-Level Security (RLS) is enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [Server-Only Secret - NEVER prefix with NEXT_PUBLIC_ or import into client components]
# Supabase service-role key for privileged administrative operations when explicitly required.
SUPABASE_SERVICE_ROLE_KEY=

# [Server-Only Secret - Optional AI Report Draft Feature]
# OpenAI API key used exclusively on the server to generate visit report drafts. Leave blank to disable AI drafts.
OPENAI_API_KEY=

# [Server-Only Config - Optional AI Report Draft Feature]
# Explicit OpenAI Responses API model identifier (e.g., gpt-4o-mini or gpt-4.1-mini). Required alongside OPENAI_API_KEY to enable AI drafts.
OPENAI_REPORT_MODEL=

# [Server-Only Config - Optional AI Report Draft Feature]
# Optional OpenAI API base URL override (defaults to https://api.openai.com/v1 when omitted).
OPENAI_API_BASE_URL=

# [Server-Only Config - Optional AI Report Draft Feature]
# Optional request timeout in milliseconds (1000-60000; defaults to 15000 when omitted).
OPENAI_REQUEST_TIMEOUT_MS=

# [Server-Only Config - Optional AI Report Draft Feature]
# Optional maximum output token cap per draft generation (128-4096; defaults to 1200 when omitted).
OPENAI_MAX_OUTPUT_TOKENS=

# [Server] Deployment environment: development | production.
APP_ENV=

# [Server] Supabase project ref (the subdomain of NEXT_PUBLIC_SUPABASE_URL) expected for THIS
# environment. Required for hosted deployments; startup fails if the URL points at another project.
EXPECTED_SUPABASE_PROJECT_REF=

# [Server] Incident kill switches. Set to "false" and redeploy to disable. Default: enabled.
AI_REPORTS_ENABLED=
UPLOADS_ENABLED=

# [Server-Only Secret - Scheduled Jobs & Cron Authentication]
# Dedicated bearer token or x-cron-secret header for unattended schedulers triggering /api/orgs/[orgId]/digest.
CRON_SECRET=

# [Public - Browser Map & Places]
# Optional Google Maps API key restricted to HTTP referrers (e.g. https://your-domain.com/*)
# and enabled only for Maps JavaScript API and Places API. Leave blank to run FieldTrack in unconfigured-map mode.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# [Server-Only Secret - Google Routes API]
# Optional Google Routes API key restricted to server IP addresses and the Routes API.
# NEVER prefix with NEXT_PUBLIC_ or import into client components. Leave blank to disable Google Road Routing.
GOOGLE_MAPS_ROUTES_API_KEY=

# [Server-Only Config - Road-Network Routing Provider]
# Set to "google" for Google Routes API (requires GOOGLE_MAPS_ROUTES_API_KEY),
# "osrm" for OpenStreetMap routing, or leave blank for straight-line Haversine geodesic fallback.
ROUTING_PROVIDER=
# Optional OSRM backend URL (defaults to https://router.project-osrm.org if omitted)
OSRM_BASE_URL=

# [Web Push - Browser & Server]
# VAPID public key exposed to the browser to generate push subscriptions via PushManager.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# [Web Push - Server-Only Secret - NEVER expose to browser]
# VAPID private key used by web-push to sign notification dispatch requests.
VAPID_PRIVATE_KEY=
# Contact email or URL required by the VAPID specification (e.g. mailto:support@fieldtrack.example.com).
VAPID_SUBJECT=

# [Server-Only Secret - Email Dispatch Provider]
# Resend API key used for invitation emails and existing notification/digest email.
# Keep this server-only; never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# [Server-Only Config - Verified Resend Sender]
# Must be verified in your Resend account, e.g. FieldTrack <invites@your-domain.com>.
RESEND_FROM_EMAIL=

# [Local Development Only - Mailtrap Email Testing]
# Uses Mailtrap's sandbox SMTP; invitation emails are captured, never delivered to recipients.
# Only used when NODE_ENV=development. Keep both values server-only.
# To select Mailtrap on a deployed test environment, set INVITATION_EMAIL_PROVIDER=mailtrap there.
# Set INVITATION_EMAIL_PROVIDER=disabled to block invitation emails, or =resend to enable Resend.
MAILTRAP_USER=
MAILTRAP_PASS=
# Optional sender shown in captured messages.
MAILTRAP_FROM_EMAIL=FieldTrack <invites@fieldtrack.local>

# [Server Only]
# Base64url-encoded 32-byte key used to encrypt invitation tokens for safe email retries.
# Generate a unique value per environment; never commit the real value.
INVITATION_TOKEN_ENCRYPTION_KEY=

# [Server-Only Secret - Stripe SaaS Billing & Subscriptions]
# Stripe API secret key (use sk_test_... in development/preview, sk_live_... in production).
# NEVER prefix with NEXT_PUBLIC_ or import into client components.
STRIPE_SECRET_KEY=

# [Server-Only Secret - Stripe Webhook Verification]
# Stripe webhook endpoint signing secret (whsec_...) for /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# [Server-Only Config - Stripe Recurring Plan Price IDs]
# Stripe Price IDs for Pro and Enterprise monthly plans (price_...).
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=

# [Server-Only Config - Optional Stripe API Base URL Override]
# Defaults to https://api.stripe.com/v1 when omitted.
STRIPE_API_BASE_URL=
